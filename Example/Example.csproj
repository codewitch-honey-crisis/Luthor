<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Write generated files to obj/.../generated so you can read them -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luthor.Generator\Luthor.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    
  </ItemGroup>

</Project>
